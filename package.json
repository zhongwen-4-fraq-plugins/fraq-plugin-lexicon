{
  "name": "fraq-plugin-lexicon",
  "type": "module",
  "version": "0.3.6",
  "description": "支持多词库、精确与模糊匹配以及嵌套词条解析的 Fraq 插件",
  "files": [
    "dist",
    "docs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "check": "biome check . && tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "test:mock": "tsx --test test/fraq-integration.test.ts",
    "prepack": "pnpm build"
  },
  "keywords": [
    "fraq",
    "fraq-plugin",
    "milky",
    "qq-bot",
    "lexicon",
    "chatbot",
    "sqlite",
    "template"
  ],
  "author": {
    "name": "zhongwen-4",
    "email": "2401128923@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhongwen-4-fraq-plugins/fraq-plugin-lexicon.git"
  },
  "homepage": "https://github.com/zhongwen-4-fraq-plugins/fraq-plugin-lexicon#readme",
  "bugs": {
    "url": "https://github.com/zhongwen-4-fraq-plugins/fraq-plugin-lexicon/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.15.1",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@fraqjs/plugin-mock": "^1.1.0",
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.12",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@fraqjs/fraq": "^1.1.0"
  },
  "fraq": {
    "category": "utilities"
  }
}
